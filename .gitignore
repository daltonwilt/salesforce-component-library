# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# For useful gitignore templates see: https://github.com/github/gitignore

# --- Salesforce CLI local state --------------------------------------
.sf/
.sfdx/
.localdevserver/
deploy-options.json
.sfdx-data/

# mdapi conversion + retrieve output
mdapiout/
mdapi_output_dir/
sfdx-out/
*.zip

# --- Node / tooling --------------------------------------------------
node_modules/
coverage/
.eslintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Auto-generated by the CLI, not worth tracking
**/lwc/jsconfig.json
**/.eslintrc.json

# --- Secrets ---------------------------------------------------------
.env
.env.*

# JWT CI auth material. Never commit these — a leaked server.key plus the connected
# app's consumer key is full org access. Keep them in CI secrets instead.
server.key
*.key
*.p12
*.pfx
*.jks
*.csr
*.crt
*.pem
authFiles/

# Root-only: the JWT keypair lives in assets/ per the Salesforce CI convention.
# Anchored with a leading slash so it does NOT match the assets/ folders inside
# static resource bundles (22 bundles, 515 tracked files).
/assets/

# --- Editor / OS -----------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.idea/
*.swp

# VS Code — keep shared settings, drop personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json